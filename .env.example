# ==============================================================================
# NerdLab API - Configurações de Ambiente (.env)
# ==============================================================================
# Por padrão, o projeto roda localmente em memória com H2 Database sem precisar
# de nenhuma variável configurada. Para usar PostgreSQL ou customizar a aplicação,
# configure as variáveis abaixo:

# ------------------------------------------------------------------------------
# Banco de Dados (PostgreSQL - Opcional para desenvolvimento local)
# ------------------------------------------------------------------------------
# Para rodar com PostgreSQL, descomente as linhas abaixo:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nerdlab_db
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ------------------------------------------------------------------------------
# Hibernate e JPA
# ------------------------------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true

# ------------------------------------------------------------------------------
# Segurança & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=vW7v5w8x/A?D(G+KbPeShVmYq3t6w9z$C&E)H@McQfTjWnZr4u7x!A%D*G-KaPdS
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# CORS (Origens permitidas para o Frontend)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Administrador Inicial Padrão
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@nerdlab.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
